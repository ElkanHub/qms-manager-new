# ============================================================================
# QMS Foundation — environment template
# Copy to `.env.local` and fill in. NOTHING here is committed (.gitignore).
# Every value is a credential YOU provide; the build leaves them blank on purpose.
# ============================================================================

# ---- Supabase project (hosted) --------------------------------------------
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used by server actions / provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Database (for migrations & SQL tests) --------------------------------
# From: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Used by `supabase db push` (via linked project) and the SQL test runner.
SUPABASE_DB_URL=
# Project ref (the xxxx in xxxx.supabase.co) — used by `supabase link`.
SUPABASE_PROJECT_REF=
# Supabase access token for CLI (dashboard → Account → Access Tokens). CI/link only.
SUPABASE_ACCESS_TOKEN=

# ---- Google OAuth (identity: Google SSO, Phase 3) — OPTIONAL for hosted ----
# You do NOT need these for a hosted Supabase project. Configure Google entirely
# in the Supabase dashboard (Auth → Providers → Google): paste the client id/secret
# and add the redirect URL (https://<project-ref>.supabase.co/auth/v1/callback).
# The app just calls Supabase's provider — no app code reads these values.
# They are ONLY used by the local `supabase start` stack (config.toml), which needs
# Docker. Since you're on hosted, leave them blank.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- App ------------------------------------------------------------------
# Public base URL of this app (used for OAuth redirect + invite links).
# Local: http://localhost:3000  |  Staging/prod: your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Auth / MFA tuning (Phase 3; principle fixed, values tunable) ---------
# Trusted-device remember window in days before MFA is re-challenged.
MFA_TRUSTED_DEVICE_DAYS=30

# ---- Platform bootstrap (Phase 5) -----------------------------------------
# Email of the very first Platform Owner (the only account not created by invite).
# Used once by the bootstrap seed to mint the platform-plane root.
PLATFORM_OWNER_EMAIL=
